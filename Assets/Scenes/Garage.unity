--- !u!114 &1952398266966866424
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1951103966315979577}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c2004c63d3dcd9b4499cdb035e17f2b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lift: {fileID: 1952398266966866423}
  jack: {fileID: 1013218462}
  jackSpot: {fileID: 472553715}
  nuts:
  - {fileID: 1931725259}
  - {fileID: 404845730}
  - {fileID: 350860439}
  - {fileID: 1892663022}
  - {fileID: 1308262794}
  - {fileID: 188949851}
  hub: {fileID: 1542973094}
  engine: {fileID: 1952398266966866422}
  seat: {fileID: 1952398266966866420}
  phone: {fileID: 0}
  callDelay: 1.5
  caller: Papa
  callEnglish:
  - time: 0.1
    text: Hello son, are you out yet?
  - time: 2.15
    text: What? A flat tyre?! Of all days...
  - time: 6.1
    text: Don't panic. Switch off and get out first.
  - time: 8.95
    text: The jack and the spare are in the back corner.
  - time: 11.15
    text: The wrench is in the tool bag - the one you knocked down.
  - time: 14
    text: Change it quickly - I'm almost there!
  callHinglish:
  - time: 0
    text: Haan beta, nikal gaye?
  - time: 1.8
    text: Kya? Puncture?! Uff, aaj hi hona tha...
  - time: 5.9
    text: Ghabra mat. Pehle gaadi band karke bahar aa.
  - time: 8.85
    text: Jack aur stepney peeche wale kone mein hain.
  - time: 11.35
    text: Spanner auzaaron ke jhole mein hai - jo tune giraya tha.
  - time: 13.2
    text: Jaldi tyre badal, main pahunch hi raha hun!
  voiceEnglish: {fileID: 8300000, guid: 2ecc01aa1df1a004ab976524bee4a7bb, type: 3}
  voiceHinglish: {fileID: 8300000, guid: d38f7cdb5aaba7e47956ef86820cc179, type: 3}
  hud: {fileID: 0}
