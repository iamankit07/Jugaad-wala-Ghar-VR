--- !u!1001 &760178917
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: hud
      value: 
      objectReference: {fileID: 1480917182}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: callerName
      value: Papa
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: voiceEnglish
      value: 
      objectReference: {fileID: 8300000, guid: d0b3989e74ca6694bbad14ca2216338b, type: 3}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: voiceHinglish
      value: 
      objectReference: {fileID: 8300000, guid: 56ec2e2d39ba05546895dc259379d478, type: 3}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[0].text
      value: Hey son, listen.
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[0].time
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[1].text
      value: We have a wedding this evening - the car has to come out of the garage.
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[1].time
      value: 1.6
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[2].text
      value: But the garage is a mess - the bulb is fused and the shutter is stuck.
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[2].time
      value: 5.45
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[3].text
      value: Do some jugaad, okay? I'll be home in 20 minutes!
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesEnglish.Array.data[3].time
      value: 9.7
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[0].text
      value: Haan beta, sun.
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[0].time
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[1].text
      value: Shaam ko shaadi mein jaana hai, gaadi garage se nikalni hai.
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[1].time
      value: 1.6
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[2].text
      value: Par garage ka haal bura hai - bulb fuse hai, shutter atka hua hai.
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[2].time
      value: 5.35
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[3].text
      value: Tu hi kuch jugaad kar de. Main aadhe ghante mein aata hun!
      objectReference: {fileID: 0}
    - target: {fileID: 2270422134178058177, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: linesHinglish.Array.data[3].time
      value: 9.95
      objectReference: {fileID: 0}
    - target: {fileID: 5911038451084031945, guid: dd91a2b1ca1a2ea4da6a802f0045b6ec, type: 3}
      propertyPath: m_Name
      value: Phone
      objectReference: {fileID: 0}
