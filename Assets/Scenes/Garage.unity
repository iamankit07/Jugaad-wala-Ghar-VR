--- !u!114 &1952398266966866421
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1951103966315979577}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd3fa8ace6da53846a48277d5b062ed4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  key: {fileID: 1066053066}
  battery: {fileID: 148638925}
  phone: {fileID: 760178919}
  deadClick: {fileID: 8300000, guid: 400dea6df07f99b48adddf19cd238fec, type: 3}
  deadAttempts:
  - {fileID: 8300000, guid: 2406e9055f3905c4e8ba04fea6eacbea, type: 3}
  - {fileID: 8300000, guid: a8342f1230acef5469915ee223900021, type: 3}
  - {fileID: 8300000, guid: 2bd687b54d439ce4187dba89b24ea022, type: 3}
  callDelay: 1.4
  caller: Papa
  callEnglish:
  - time: 0
    text: Hey, did the car start?
  - time: 1.85
    text: Nothing at all? Oh wait!
  - time: 3.8
    text: I took the battery out to charge it - it's by the pipe.
  - time: 6.65
    text: Open the bonnet and put it in. Hurry, I'm almost home!
  callHinglish:
  - time: 0
    text: Haan beta, gaadi start hui?
  - time: 2.1
    text: Kuch nahi hua? Arre haan!
  - time: 4
    text: Battery to maine charge karne ke liye nikaali thi - pipe ke paas rakhi
      hai.
  - time: 7.85
    text: Bonnet khol ke laga de. Jaldi kar, main bas pahunch raha hun!
  voiceEnglish: {fileID: 8300000, guid: 9787dc8970b0f664fbff63ead9a991e8, type: 3}
  voiceHinglish: {fileID: 8300000, guid: cc7697931d1c6594ca0b2758ad5d4b2f, type: 3}
