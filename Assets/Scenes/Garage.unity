  m_Name: 
  m_EditorClassIdentifier: 
  car: {fileID: 1952398266966866423}
  drive: {fileID: 1952398266966866425}
  parkingSpot: {fileID: 127678246}
  slack: {x: 0.9, y: 1.3}
  stopSpeed: 0.08
  holdTime: 0.6
  marker: {fileID: 863783097}
  fill: {fileID: 834788804}
  label: {fileID: 836368838}
  fillColor: {r: 1, g: 0.8, b: 0.1, a: 0.18}
  fillParkedColor: {r: 0.3, g: 1, b: 0.4, a: 0.3}
  phone: {fileID: 760178919}
  callDelay: 1.2
  caller: Papa
  callEnglish:
  - time: 0.1
    text: Hey son, how's it going? Is the car out?
  - time: 3
    text: Wow!
  - time: 4.05
    text: The bulb, the shutter, the battery, the puncture... all with hack?!
  - time: 9.3
    text: Well done, champ!
  - time: 10.9
    text: You've really pulled it off.
  - time: 12.65
    text: I'm at the end of the street, and Mummy's ready too.
  - time: 15.15
    text: Come on, let's go to the wedding!
  callHinglish:
  - time: 0.1
    text: Haan beta, kya hua? Gaadi nikli?
  - time: 2.64
    text: Arre waah!
  - time: 3.75
    text: Bulb, shutter, battery, puncture... sab jugaad se?!
  - time: 7.83
    text: Shabash mere sher!
  - time: 9.69
    text: Tune toh kamaal kar diya.
  - time: 11.4
    text: Main gali ke mod pe hun, mummy bhi taiyaar hai.
  - time: 13.77
    text: Chal, ab shaadi mein chalte hain!
  voiceEnglish: {fileID: 8300000, guid: ca595fc5bd49b6e47bedc74700e10f1d, type: 3}
  voiceHinglish: {fileID: 8300000, guid: d8ceca245ea36844da7a2310afcef025, type: 3}
  hud: {fileID: 1480917182}
