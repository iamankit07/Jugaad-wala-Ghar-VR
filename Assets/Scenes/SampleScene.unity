--- !u!114 &53955159
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 53955158}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91bd0a885020a1b41899b8b7bf6f2df6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tasks:
  - title: TV chalu karo - Kuch new aya hai!
    hint: Remote ka dhakkan khula hai... table pe kuch hai jisse baandh sako?
    doneText: TV chalu! Ab Sone chalte hain
    hintImmediately: 1
    hintDelay: 60
    basePoints: 1000
    titleEn: Turn on the TV - something new is on!
    hintEn: The remote's cover is loose... anything on the table to tie it with?
    doneTextEn: TV is on! Now off to sleep
  - title: Bed room jaana hai - darwaza kholo
    hint: Chaabi nahi hai? Koi PATLI si cheez keyhole mein daal ke dekho like koi
      safety pin and handle neeche dabake kheencho
    doneText: Darwaza khul gaya!
    hintImmediately: 1
    hintDelay: 60
    basePoints: 1000
    titleEn: Go to the bedroom - open the door
    hintEn: No key? Poke something THIN into the keyhole, like a safety pin, then
      press the handle down and pull
    doneTextEn: The door is open!
  - title: Darwaza khud band ho jaata hai... jugaad lagao!
    hint: Kitaab ya gamla darwaze ke saamne rakh do, taaki khula rahe
    doneText: Jugaad successful!
    hintImmediately: 1
    hintDelay: 60
    basePoints: 1000
    titleEn: The door keeps shutting by itself... use a jugaad!
    hintEn: Put a book or the plant pot in front of the door so it stays open
    doneTextEn: Jugaad successful!
  - title: Bedroom ki chaabi dhundo Store Room mee hi hoga
    hint: Store room ke console ke NEECHE dekho... haath nahi jaata, kuch CHIPKANE
      wala dhundo
    doneText: Bedroom khul gaya!
    hintImmediately: 0
    hintDelay: 60
    basePoints: 1000
    titleEn: Find the bedroom key - it must be in the Store Room
    hintEn: Look UNDER the console in the store room... your hand won't reach, find
      something that STICKS
    doneTextEn: Bedroom unlocked!
  - title: Bedroom mein andhera hai - light jalao
    hint: Deewar pe switchboard hai - ungli se button dabao
    doneText: Roshni aa gayi!
    hintImmediately: 0
    hintDelay: 45
    basePoints: 1000
    titleEn: The bedroom is dark - turn on the light
    hintEn: There's a switchboard on the wall - press the button with your finger
    doneTextEn: Let there be light!
  - title: Garmi hai - fan chalao
    hint: Switchboard pe FAN wala button dabao
    doneText: Arre! Fan ka switch hi kharab hai...
    hintImmediately: 0
    hintDelay: 45
    basePoints: 1000
    titleEn: It's hot - turn on the fan
    hintEn: Press the FAN button on the switchboard
    doneTextEn: Oh no! The fan switch is broken...
  - title: Fan ka remote dhundo aur theek karo
    hint: Remote bed pe hai... desk pe rakhe rubber band se dhakkan baandho
    doneText: Thandi hawa! Goodnight!
    hintImmediately: 0
    hintDelay: 60
    basePoints: 1000
    titleEn: Find the fan remote and fix it
    hintEn: The remote is on the bed... tie its cover with a rubber band from the
      desk
    doneTextEn: Cool breeze! Goodnight!
  pointsLostPerSecond: 5
  minPoints: 200
  hintPenalty: 0.2
  masterScore: 5000
  goodScore: 3500
  introDelay: 2
  introDuration: 4.5
  pauseBetweenTasks: 2.5
