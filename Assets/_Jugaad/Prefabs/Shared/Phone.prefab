  m_Name: 
  m_EditorClassIdentifier: 
  hud: {fileID: 0}
  callerName: Mummy
  ringtone: {fileID: 8300000, guid: c9a6a3f1a59056f48963898a3fe761d2, type: 3}
  ringVolume: 0.5
  pickupSound: {fileID: 8300000, guid: c4b65ff04755a4b41b72d5fff977c310, type: 3}
  hangupSound: {fileID: 8300000, guid: 0b4c6c2ef571c49488f87fad85e6aecc, type: 3}
  voiceEnglish: {fileID: 8300000, guid: f4a80780eead38d4db3d42d183741976, type: 3}
  voiceHinglish: {fileID: 8300000, guid: 11c5c8b5e5b29164b815262ed9a1c666, type: 3}
  voiceVolume: 0.9
  linesEnglish:
  - time: 0.25
    text: Hello beta! I've just left Nani's house.
  - time: 4.25
    text: I'll be home in twenty minutes.
  - time: 6.38
    text: My serial is about to start, switch on the TV for me!
  - time: 10.33
    text: And listen, I want my room ready. Lights, fan, everything!
  - time: 16.03
    text: No excuses. Okay, bye!
  linesHinglish:
  - time: 0.25
    text: Hello beta! Main Nani ke ghar se nikal gayi hoon.
  - time: 4.43
    text: Bas bees minute mein ghar pahunch rahi hoon.
  - time: 7.18
    text: Mera serial shuru hone wala hai, TV chalu kar dena!
  - time: 10.98
    text: Aur haan, mera kamra ekdum ready chahiye. Light, pankha, sab!
  - time: 17.19
    text: Koi bahana nahi chalega. Chalo, rakhti hoon!
  screen: {fileID: 4495208513958508579}
  callerText: {fileID: 4850835654559038935}
  statusText: {fileID: 8355964419678004989}
  screenOff: {r: 0.02, g: 0.02, b: 0.03, a: 1}
  screenRinging: {r: 0.1, g: 0.45, b: 0.28, a: 1}
  screenInCall: {r: 0.08, g: 0.16, b: 0.32, a: 1}
  screenEnded: {r: 0.25, g: 0.08, b: 0.08, a: 1}
  wiggleTarget: {fileID: 8265535079537766396}
